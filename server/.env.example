# Copy to .env and fill in real values. Never commit .env.
# Generate ENCRYPTION_KEY with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# It must be 64 hex chars (32 bytes) — the server validates this at boot.
# Rotate it like any credential: update the value, restart, re-encrypt
# stored secrets (EmailAccount credentials, Drive tokens) afterwards.

PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/leddgerai
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ENCRYPTION_KEY=PASTE_64_HEX_CHARS_HERE
FRONTEND_URL=http://localhost:5173
SERVER_URL=http://localhost:5000
CORS_ORIGINS=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_EMAIL=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_REDIRECT_URI=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
